{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parlor-561-group",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "parlor.561.group", "custom_domain": true }
  ]
}
