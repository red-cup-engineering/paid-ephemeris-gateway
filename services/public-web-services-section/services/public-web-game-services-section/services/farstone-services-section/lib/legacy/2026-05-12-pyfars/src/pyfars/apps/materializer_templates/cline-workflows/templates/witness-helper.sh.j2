#!/usr/bin/env bash
# Generated by PyFARS `cline-workflows` harness — DO NOT HAND-EDIT.
# Re-run `pyfars install-harness cline-workflows` to refresh.
#
# Usage: cline-witness.sh <runbook-slug> <step-label> [truth=1.0] [evidence=1.0]
set -euo pipefail
if [[ $# -lt 2 ]]; then
  echo "usage: cline-witness.sh <runbook-slug> <step-label> [truth=1.0] [evidence=1.0]" >&2
  exit 64
fi
RUNBOOK="$1"; STEP="$2"; TRUTH="${3:-1.0}"; EVIDENCE="${4:-1.0}"
# Per governance/specifications/nix-harness.md §6.2 (in pyfars repo):
# invoke pyfars via nix run rather than baking a path or assuming bare
# `pyfars` is on the cline shell PATH.
exec nix run ".#pyfars" -- witness \
  --operator "cline_runbook_step:$RUNBOOK" \
  --target   "cline-workflow:$RUNBOOK" \
  --channel  dispatch \
  --origin   "cline-workflow:$RUNBOOK" \
  --truth    "$TRUTH" \
  --evidence "$EVIDENCE" \
  --detail   "step=$STEP" \
  --detail   "runbook=$RUNBOOK"
