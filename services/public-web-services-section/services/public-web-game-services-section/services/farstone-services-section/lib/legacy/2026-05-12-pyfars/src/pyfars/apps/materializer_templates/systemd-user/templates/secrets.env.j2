# <polity>/.pyfars/secrets.env (template).
#
# Copy this file to ``secrets.env`` in the same directory and fill in
# the values for your deployment. The real ``secrets.env`` is gitignored
# — it contains real credentials and must not be committed.
#
# The systemd-user service unit's ``EnvironmentFile=`` points at the
# real ``secrets.env`` (per engine-service-spec §7.1: instance-locality
# discipline; everything PyFARS reads or writes for an instance lives
# inside the instance directory).
#
# ``EngineProgram.boot`` (``pyfars.programs.engine.program``) reads
# this file into ``os.environ`` so dev runs (``pyfars run <root>``) and
# systemd-supervised runs share the same secrets surface.

# --- OAuth (Google federation) -----------------------------------------
# Required when the polity's web or MCP service has OAuth-authenticated
# routes. Without these, public routes still work; authenticated routes
# return 503 with "AS not configured".

# Public — Google Cloud Console client ID
PYFARS_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Secret — Google Cloud Console client secret. The whole file is mode
# 600 and gitignored; this is where the secret material sits.
PYFARS_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Public — the AS issuer URL clients use to discover us. Must match the
# host the operator connects to. For local dev: http://127.0.0.1:8000.
# For production behind TLS termination: https://<your-host>:<port>.
PYFARS_OAUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000
