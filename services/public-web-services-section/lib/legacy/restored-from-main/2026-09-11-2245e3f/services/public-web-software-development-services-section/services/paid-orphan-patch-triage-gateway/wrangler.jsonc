{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paid-orphan-patch-triage-gateway",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "orphan-patch.561.group",
      "custom_domain": true
    }
  ],
  // Every settlement-affecting value is deployment-supplied, never a source
  // constant -- see boundaryFor() in src/worker.mjs. X402_PAY_TO is a
  // `wrangler secret put` value, not a var (same policy as
  // paid-ephemeris-gateway/wrangler.jsonc: see the 2026-08-31
  // x402-payto-decision record in x402-services-section/data/records/).
  "vars": {
    "X402_NETWORK": "eip155:8453",
    "X402_FACILITATOR": "https://facilitator.payai.network"
  }
}
