{
  "name": "@emsenn/cassia-lorne.substack.com",
  "version": "0.0.1",
  "type": "module",
  "description": "Cassia Lorne's Routine Read — a syndication-only divination publication: a two-stage daily diviner cycle (atomic divinations, then synthesis under gates) into a reviewable content store.",
  "exports": {
    ".": "./src/indicators.ts",
    "./gates": "./src/gates.ts",
    "./mill": "./src/mill.ts",
    "./read": "./src/read.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "divine:indicators": "node src/indicators.ts",
    "divine:read": "node src/read.ts",
    "divine": "pnpm run divine:indicators && pnpm run divine:read",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@emsenn/computing": "workspace:*",
    "@emsenn/divining": "workspace:*",
    "@emsenn/organizing-a-content-mill": "workspace:*",
    "@emsenn/producing-a-newswire": "workspace:*",
    "@emsenn/producing-content": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
