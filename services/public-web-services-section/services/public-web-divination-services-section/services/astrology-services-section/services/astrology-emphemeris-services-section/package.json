{
  "name": "@red-cup-engineering/paid-ephemeris-gateway",
  "version": "0.2.4",
  "type": "module",
  "description": "x402 seller for two exact-moment astronomy/astrology products: $0.04 deterministic essentials and $0.32 JPL DE440 precision, each with provenance and explicit semantic layers.",
  "engines": {
    "node": ">=22.18"
  },
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "scripts",
    "src"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "start:deployment": "node src/deployment.mjs",
    "assay:cdp": "node scripts/verify-cdp-facilitator.mjs",
    "assay:public": "node scripts/verify-public-offer.mjs",
    "test": "node --test test/*.test.mjs test/prove.mjs"
  },
  "dependencies": {
    "@lenticule-science/divination-services-section": "2.0.2",
    "@red-cup-engineering/semantic-record-journal-service": "0.1.8",
    "@red-cup-engineering/witness-journal-document-service": "1.0.1",
    "@red-cup-engineering/x402-services-section": "1.3.3",
    "@red-cup-engineering/x402-settlement-witness-identity": "0.2.0",
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "@x402/extensions": "2.19.0",
    "@x402/svm": "2.19.0",
    "express": "5.2.1"
  },
  "keywords": [
    "x402",
    "ephemeris",
    "sovereign-state-enterprise"
  ]
}
