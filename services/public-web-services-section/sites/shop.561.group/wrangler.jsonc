{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop-561-group",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "shop.561.group",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHOP_ENTITLEMENTS",
      "id": "9372634aa5ca4c87937c6d3dd457bef6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOP_GOODS",
      "bucket_name": "shop-561-group-goods"
    }
  ]
}
