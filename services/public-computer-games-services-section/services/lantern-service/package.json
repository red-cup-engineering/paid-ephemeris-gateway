{
  "name": "@red-cup-engineering/lantern-561-group",
  "version": "0.1.0",
  "type": "module",
  "description": "VaultMaze engine (legacy Lantern package identity) — a walkable knowledge map lit by FSRS-lite spaced repetition.",
  "exports": {
    "./lightcone": "./src/lightcone.mts",
    "./srs": "./src/srs.mts"
  },
  "scripts": {
    "check": "node check-mts.mjs src/*.mts",
    "test": "node --test src/*.test.mts",
    "compile:weiqi": "node src/compile.mts \"$WEIQI_ROOT\" weiqi data/world-weiqi.json",
    "build:web": "node web/build/build-layout.mts weiqi data/world-weiqi.json web/data",
    "serve:web": "node web/server.mjs",
    "test:web": "node --test web/test/*.test.mts",
    "vaultmaze": "node scripts/vaultmaze.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@561-group/vault-compiler": "file:../../../../../../../engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-knowledge-systems-services-section/services/knowledge-vault-computer-system-services-section/services/vault-compiler"
  }
}
