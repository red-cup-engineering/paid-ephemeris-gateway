{
  "name": "@causeway-services/vaultmaze-service",
  "version": "0.1.0",
  "type": "module",
  "description": "VaultMaze is a walkable knowledge map lit by FSRS-lite spaced repetition.",
  "exports": {
    "./lightcone": "./src/lightcone.mts",
    "./srs": "./src/srs.mts"
  },
  "scripts": {
    "check": "tsc --noEmit --noCheck --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target esnext src/*.mts",
    "test": "node --test src/*.test.mts",
    "compile:weiqi": "node src/compile.mts \"$WEIQI_ROOT\" weiqi data/world-weiqi.json",
    "build:web": "node web/build/project-platform-engine.mjs && node web/build/build-layout.mts weiqi data/world-weiqi.json web/data",
    "serve:web": "node web/server.mjs",
    "test:web": "node --test web/test/*.test.mts",
    "vaultmaze": "node scripts/vaultmaze.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@red-cup-engineering/vault-compiler": "0.1.2",
    "@red-cup-engineering/education-platform-service": "0.2.4",
    "@red-cup-engineering/read-markdown-frontmatter-service": "0.1.4"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
