{
  "name": "@red-cup-engineering/tidepool.emsenn.net",
  "version": "0.1.0",
  "type": "module",
  "description": "Tidepool: an LLM-native MUD (agents and humans as first-class players alike) — a tidal shore built on current FeltOS, transported by qwzspace rooms, wired to a fully agent-legible perception-frame protocol.",
  "scripts": {
    "test": "node --test",
    "serve": "node src/serve.mts",
    "bot": "node agents/reference-bot.mjs",
    "term": "node terminal/tidepool-term.mjs"
  },
  "exports": {
    ".": "./src/index.mts",
    "./game": "./src/tidepool-game.mts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/feltos": "0.10.1",
    "@red-cup-engineering/qwzspace": "0.6.3",
    "@red-cup-engineering/web-tufte-gui-services-section": "0.6.0",
    "@red-cup-engineering/world-hosting": "0.3.0"
  },
  "optionalDependencies": {
    "@red-cup-engineering/arnold": "0.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false
}
