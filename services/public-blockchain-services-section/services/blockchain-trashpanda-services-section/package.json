{
  "name": "@red-cup-engineering/blockchain-trashpanda-services-section",
  "version": "0.3.1",
  "type": "module",
  "description": "Blockchain Trashpanda Services Section: deterministic pre-sign policy conformance, market-action admission, and x402 commercial boundary.",
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./market-action-admission": "./src/market-action-admission.mjs",
    "./x402-service": "./src/x402-service.mjs",
    "./x402-settlement-witness": "./src/x402-settlement-witness.mjs",
    "./settlement-witness": "./src/settlement-witness.mjs",
    "./production-gate": "./src/production-gate.mjs",
    "./virtuals-commercial-pilot-guard": "./src/virtuals-commercial-pilot-guard.mjs",
    "./virtuals-commercial-pilot-runtime": "./src/virtuals-commercial-pilot-runtime.mjs",
    "./virtuals-lite-commercial-pilot": "./src/virtuals-lite-commercial-pilot.mjs",
    "./virtuals-lite-production": "./src/virtuals-lite-production.mjs",
    "./virtuals-market-action": "./src/virtuals-market-action.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:deployment": "node src/deployment.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:production-gate": "node src/production-gate.mjs",
    "verify:formation": "node src/verify-enterprise-goal.mjs --cell formation && node src/verify-enterprise-goal.mjs --cell governance && node src/verify-enterprise-goal.mjs --cell economics",
    "verify:production-goal": "node src/verify-production-goal.mjs",
    "verify:goal": "node src/verify-enterprise-goal.mjs --all"
  },
  "dependencies": {
    "@account-kit/infra": "4.84.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.7",
    "@red-cup-engineering/semantic-record-journal-service": "0.1.8",
    "@red-cup-engineering/witness-journal-entry-service": "0.1.7",
    "@red-cup-engineering/witness-journal-log-service": "0.1.6",
    "@red-cup-engineering/x402-services-section": "1.3.3",
    "@red-cup-engineering/x402-settlement-witness-identity": "0.2.0",
    "@virtuals-protocol/acp-node-v2": "0.1.8",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "socket.io-client": "4.8.1",
    "@red-cup-engineering/witness-journal-document-service": "1.0.1"
  }
}
