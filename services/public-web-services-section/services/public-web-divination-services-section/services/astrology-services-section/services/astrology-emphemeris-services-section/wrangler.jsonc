{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paid-ephemeris-gateway",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ephemeris.561.group",
      "custom_domain": true
    }
  ],
  // Every settlement-affecting value is deployment-supplied, never a source
  // constant -- see boundaryFor() in src/worker.mjs. X402_PAY_TO is a
  // `wrangler secret put` value, not a var; the payout address it carries is
  // recorded beside this file in 402index-listing.json.
  "vars": {
    "X402_NETWORK": "eip155:8453",
    "X402_FACILITATOR": "https://facilitator.payai.network"
  }
}
