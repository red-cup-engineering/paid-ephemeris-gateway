{
  "name": "@red-cup-engineering/paid-ephemeris-gateway",
  "version": "0.3.0",
  "type": "module",
  "description": "Astronomy and divining offers over shared numerical computation and the shared x402 seller engine.",
  "engines": {
    "node": ">=22.18"
  },
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json",
    "./application": "./src/application.mjs",
    "./worker": "./src/worker.mjs"
  },
  "files": [
    "README.md",
    "scripts",
    "src",
    "data/contracts"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "start:deployment": "node src/deployment.mjs",
    "assay:cdp": "node scripts/verify-cdp-facilitator.mjs",
    "assay:public": "node scripts/verify-public-offer.mjs",
    "test": "node --test test/*.test.mjs test/prove.mjs"
  },
  "dependencies": {
    "@lenticule-science/astronomy-services-section": "0.4.2",
    "@lenticule-science/divination-services-section": "0.2.3",
    "@red-cup-engineering/semantic-record-journal-service": "0.4.0",
    "@red-cup-engineering/web-server-services-section": "0.1.5",
    "@red-cup-engineering/witness-journal-document-service": "0.1.0",
    "@red-cup-engineering/x402-market-observation-service": "0.2.0",
    "@red-cup-engineering/x402-offer-seller-service": "0.2.0",
    "@red-cup-engineering/x402-services-section": "0.9.3",
    "@red-cup-engineering/x402-settlement-witness-identity": "0.2.0"
  },
  "keywords": [
    "x402",
    "ephemeris",
    "sovereign-state-enterprise"
  ],
  "devDependencies": {
    "wrangler": "4.129.0"
  }
}
