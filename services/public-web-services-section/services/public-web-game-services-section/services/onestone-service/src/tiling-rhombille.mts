/**
 * `tiling-rhombille` — the rhombille tiling cell builder: chapter 3's grid.
 *
 * The rhombille tiling is the one that sells the "the grid itself is the differentiator"
 * pitch — its three rhombus orientations, shaded into three lightness steps of a tile's
 * color, read as the classic "tumbling cubes" illusion (Necker-cube ambiguity for free,
 * no art budget spent). Geometrically it is generated by taking a radius-`size` patch of
 * regular hexagons (same axial |q|,|r|,|q+r| <= size condition as tiling-hex.mts, but this
 * hex patch is scaffolding only — it never becomes a `Cell` itself) and splitting EACH
 * hexagon into 3 rhombi by drawing spokes from its center to three alternating vertices.
 *
 * Why the 3-way split is automatically a rhombus split: a regular hexagon's circumradius
 * equals its side length. Spoking the center to vertices 0, 2, 4 carves the hexagon into
 * three quads (center, v_2k, v_2k+1, v_2k+2) for k = 0, 1, 2. Every side of each quad —
 * the two spokes and the two hex-boundary edges it walks — has that same length R, so each
 * quad is an equilateral quadrilateral (a rhombus) with no further correction needed.
 *
 * Why this produces a valid shared-edge tiling for free, with no explicit stitching: two
 * hexagons adjacent in the patch are pure translations of one another (no rotation), so a
 * boundary edge shared between them is built from the SAME pair of absolute corner
 * coordinates on both sides — one hex's `corner(i)`/`corner(i+1)` pair IS its neighbor's
 * `corner(i+3)`/`corner(i+4)` pair, up to floating rounding, because the neighbor's own
 * corner(i+3) sits at the neighbor's center plus the same direction vector this hex's
 * corner(i) sits at relative to its own center, and hex centers differ by exactly the
 * translation that makes those coincide. `tiling-core.mts`'s edge-key quantization (round
 * to 1e-4, sorted endpoint pair) then finds that shared edge and wires the adjacency — this
 * module never computes adjacency itself, only emits the polygons. Spoke edges (center-to-
 * vertex) never leave their own hexagon, so they only ever pair a hex's own two rhombi that
 * share that spoke — also just falls out of the same quantized-edge pass.
 *
 * `shade` is the orientation index k in {0, 1, 2} (which pair of alternating vertices the
 * rhombus spans) — purely cosmetic per DESIGN.md and `types.mts`, never read by matching.
 * It is NOT expected to agree across a shared edge: the tumbling-cube illusion depends on
 * neighboring rhombi differing in orientation, not matching (a rhombus's two boundary edges
 * point at two different neighbor hexes, so its own k has no fixed relationship to theirs).
 */

import type { RawCell } from './tiling-core.mts';

/** Unit circumradius, matching tiling-hex.mts's unit-scale convention. */
const R = 1;

/**
 * One corner of a regular pointy-top hexagon centered at (cx,cy), circumradius R.
 * `i` is not reduced mod 6 — callers pass i and i+1 and i+2 straight through, relying on
 * cos/sin's own periodicity (60*(i+6) - 30 is the same angle as 60*i - 30) to close the
 * hexagon without a branch.
 */
function corner(cx: number, cy: number, i: number): readonly [number, number] {
  const angle = (Math.PI / 180) * (60 * i - 30);
  return [cx + R * Math.cos(angle), cy + R * Math.sin(angle)];
}

/**
 * The 3 rhombi of one hex centered at (cx,cy): spokes to corners 0, 2, 4 split the hexagon
 * into quads (center, corner(2k), corner(2k+1), corner(2k+2)) for k = 0, 1, 2. Polygon
 * winding walks center -> out to the first spoke vertex -> along the hex boundary -> back
 * to center, which is a simple (non-self-intersecting) quadrilateral.
 */
function hexToRhombi(cx: number, cy: number): RawCell[] {
  const out: RawCell[] = [];
  for (let k = 0; k < 3; k++) {
    const [v0x, v0y] = corner(cx, cy, 2 * k);
    const [v1x, v1y] = corner(cx, cy, 2 * k + 1);
    const [v2x, v2y] = corner(cx, cy, 2 * k + 2);
    out.push({
      poly: [cx, cy, v0x, v0y, v1x, v1y, v2x, v2y],
      cx: (cx + v0x + v1x + v2x) / 4,
      cy: (cy + v0y + v1y + v2y) / 4,
      shade: k,
    });
  }
  return out;
}

/**
 * Builds a radius-`size` rhombille patch: 3 rhombi per hex of a radius-`size` hexagonal
 * patch, `3 * (3*size*(size+1) + 1)` rhombi total (3x the centered-hexagonal-number hex
 * count). Hex centers use the same pointy-top axial layout as tiling-hex.mts (unit
 * circumradius); the hex patch itself is pure scaffolding and is discarded after use.
 */
export function cells(size: number): RawCell[] {
  const out: RawCell[] = [];
  for (let q = -size; q <= size; q++) {
    for (let r = -size; r <= size; r++) {
      if (Math.abs(q + r) > size) continue;
      const cx = R * Math.sqrt(3) * (q + r / 2);
      const cy = R * 1.5 * r;
      out.push(...hexToRhombi(cx, cy));
    }
  }
  return out;
}
