{
  "name": "@red-cup-engineering/paid-orphan-patch-triage-gateway",
  "version": "0.1.1",
  "type": "module",
  "description": "x402 seller for the orphan-patch triage scorer: ranks packages with disclosed advisories, silent maintainers, and many dependents as orphan-patch candidates, deterministically, from public inputs alone.",
  "engines": {
    "node": ">=22.18"
  },
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./worker": "./src/worker.mjs",
    "./package.json": "./package.json",
    "./application": "./src/application.mjs"
  },
  "files": [
    "README.md",
    "src"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/jsnode-package-vulnerability-triage-services-section": "0.1.0",
    "@red-cup-engineering/x402-services-section": "0.5.0",
    "@x402/extensions": "2.19.0",
    "@red-cup-engineering/read-http-request-body-service": "0.2.1",
    "@red-cup-engineering/web-server-services-section": "0.1.1"
  },
  "keywords": [
    "x402",
    "vulnerability-triage",
    "orphan-patch",
    "supply-chain-security"
  ]
}
