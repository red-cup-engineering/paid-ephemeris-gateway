/**
 * `build-layout` — Lantern face build step, DESIGN.md's map-view requirement: "precompute
 * layout at build time (node script using a simple force-directed layout, iterations fixed
 * for determinism) so the client just draws."
 *
 * Reads the engine's compiled `data/<wing>.json` (produced by `src/compile.mts`, not touched
 * here) and writes two static files under `web/data/`:
 *
 *   - `<wing>.json`        a verbatim copy of the compiled World, so the deployed `web/`
 *                          directory is fully self-contained and the static file server never
 *                          needs to reach outside its own root.
 *   - `<wing>-layout.json` room positions (a Fruchterman–Reingold force-directed layout, fixed
 *                          seed + fixed iteration count — no wall-clock, no `Math.random()`,
 *                          so re-running this script on unchanged input reproduces the exact
 *                          same coordinates) and one auto-hall Kata per Hall, generated by the
 *                          REAL `src/kata.mts` (not a client-side re-implementation) so the
 *                          path-linearization logic has exactly one copy of the truth.
 *
 * Run: `node web/build/build-layout.mts [wing] [srcWorldPath] [outDir]`, defaults
 * `weiqi data/world-weiqi.json web/data`. Zero runtime dependencies; native `.mts` execution
 * per this repo's house constraints (see root README / package.json).
 */
import { readFile, writeFile } from 'node:fs/promises';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import type { World, Room, Door, Hall } from '../../src/types.mts';
import { makeAutoKata } from '../../src/kata.mts';

const HERE = dirname(fileURLToPath(import.meta.url));
const SERVICE_ROOT = join(HERE, '..', '..');

// --- deterministic PRNG (mulberry32) — fixed seed, never Math.random() -------------------
function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return function next(): number {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const LAYOUT_SEED = 0x9e3779b9; // fixed, arbitrary, never derived from clock/env
const WIDTH = 1000;
const HEIGHT = 720;
const PADDING = 48;
const ITERATIONS = 500;

interface Point {
  x: number;
  y: number;
}

/**
 * Fruchterman–Reingold spring-embedder, deterministic variant: fixed seed for the initial
 * placement, fixed iteration count and cooling schedule (linear from `t0` to `0` over
 * `ITERATIONS` steps) rather than a wall-clock or convergence-threshold stop condition, so the
 * same input graph always produces the same output coordinates bit-for-bit.
 */
function forceDirectedLayout(nodeIds: readonly string[], edges: ReadonlyArray<readonly [number, number]>): Map<string, Point> {
  const n = nodeIds.length;
  const area = WIDTH * HEIGHT;
  const k = Math.sqrt(area / Math.max(1, n));

  const rng = mulberry32(LAYOUT_SEED);
  // Deterministic initial placement: a ring in id-sorted order (nodeIds is already the sorted
  // order the caller passes in) plus a small seeded jitter, so the starting configuration is
  // reproducible and symmetry-broken (a perfect ring alone can stall FR in local optima).
  const pos: Point[] = nodeIds.map((_, i) => {
    const angle = (2 * Math.PI * i) / n;
    const radius = Math.min(WIDTH, HEIGHT) * 0.32;
    const jitterX = (rng() - 0.5) * k * 0.6;
    const jitterY = (rng() - 0.5) * k * 0.6;
    return {
      x: WIDTH / 2 + radius * Math.cos(angle) + jitterX,
      y: HEIGHT / 2 + radius * Math.sin(angle) + jitterY,
    };
  });

  const disp: Point[] = nodeIds.map(() => ({ x: 0, y: 0 }));
  const t0 = WIDTH / 10;

  for (let iter = 0; iter < ITERATIONS; iter++) {
    for (let i = 0; i < n; i++) disp[i] = { x: 0, y: 0 };

    // Repulsive force between every pair (n is small — 37 nodes — so O(n^2) is fine).
    for (let i = 0; i < n; i++) {
      for (let j = i + 1; j < n; j++) {
        const pi = pos[i] as Point;
        const pj = pos[j] as Point;
        let dx = pi.x - pj.x;
        let dy = pi.y - pj.y;
        let dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 0.01) {
          dist = 0.01;
          dx = 0.01;
          dy = 0;
        }
        const force = (k * k) / dist;
        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;
        (disp[i] as Point).x += fx;
        (disp[i] as Point).y += fy;
        (disp[j] as Point).x -= fx;
        (disp[j] as Point).y -= fy;
      }
    }

    // Attractive force along edges.
    for (const [a, b] of edges) {
      const pa = pos[a] as Point;
      const pb = pos[b] as Point;
      let dx = pa.x - pb.x;
      let dy = pa.y - pb.y;
      let dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 0.01) dist = 0.01;
      const force = (dist * dist) / k;
      const fx = (dx / dist) * force;
      const fy = (dy / dist) * force;
      (disp[a] as Point).x -= fx;
      (disp[a] as Point).y -= fy;
      (disp[b] as Point).x += fx;
      (disp[b] as Point).y += fy;
    }

    // Cooling: linear schedule over the fixed iteration count, not wall-clock time.
    const temperature = t0 * (1 - iter / ITERATIONS);
    for (let i = 0; i < n; i++) {
      const d = disp[i] as Point;
      const dlen = Math.sqrt(d.x * d.x + d.y * d.y) || 0.01;
      const capped = Math.min(dlen, temperature);
      const p = pos[i] as Point;
      p.x += (d.x / dlen) * capped;
      p.y += (d.y / dlen) * capped;
      p.x = Math.min(WIDTH - PADDING, Math.max(PADDING, p.x));
      p.y = Math.min(HEIGHT - PADDING, Math.max(PADDING, p.y));
    }
  }

  const out = new Map<string, Point>();
  nodeIds.forEach((id, i) => {
    const p = pos[i] as Point;
    out.set(id, { x: Math.round(p.x * 100) / 100, y: Math.round(p.y * 100) / 100 });
  });
  return out;
}

function buildEdges(nodeIds: readonly string[], doors: readonly Door[]): Array<[number, number]> {
  const index = new Map<string, number>();
  nodeIds.forEach((id, i) => index.set(id, i));
  const seen = new Set<string>();
  const edges: Array<[number, number]> = [];
  for (const d of doors) {
    const a = index.get(d.from);
    const b = index.get(d.to);
    if (a === undefined || b === undefined || a === b) continue;
    const lo = Math.min(a, b);
    const hi = Math.max(a, b);
    const key = `${lo}:${hi}`;
    if (seen.has(key)) continue;
    seen.add(key);
    edges.push([lo, hi]);
  }
  return edges;
}

async function main(): Promise<void> {
  const wing = process.argv[2] ?? 'weiqi';
  const srcPath = process.argv[3] ?? join(SERVICE_ROOT, 'data', `world-${wing}.json`);
  const outDir = process.argv[4] ?? join(HERE, '..', 'data');

  const raw = await readFile(srcPath, 'utf8');
  const world = JSON.parse(raw) as World;

  const nodeIds = world.rooms.map((r: Room) => r.id).sort();
  const edges = buildEdges(nodeIds, world.doors);
  const positions = forceDirectedLayout(nodeIds, edges);

  const katas = world.halls
    .filter((h: Hall) => h.rooms.length >= 2)
    .map((h: Hall) => makeAutoKata(h, world.doors, world.rooms));

  const positionsOut: Record<string, { x: number; y: number }> = {};
  for (const [id, p] of positions) positionsOut[id] = p;

  const layoutOut = {
    wingId: world.wingId,
    width: WIDTH,
    height: HEIGHT,
    seed: LAYOUT_SEED,
    iterations: ITERATIONS,
    positions: positionsOut,
    katas: katas.map((k) => ({ id: k.id, hallId: k.id.replace(/^kata:/, ''), path: k.path, origin: k.origin })),
  };

  await writeFile(join(outDir, `${wing}.json`), JSON.stringify(world, null, 1), 'utf8');
  await writeFile(join(outDir, `${wing}-layout.json`), JSON.stringify(layoutOut, null, 1), 'utf8');

  process.stdout.write(
    `build-layout: wrote ${nodeIds.length} room positions, ${katas.length} auto-halls katas, ` +
      `${outDir}/${wing}.json + ${outDir}/${wing}-layout.json\n`,
  );
}

// Only run when this file is the process entrypoint (mirrors sibling server.mts's own guard).
if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) {
  main().catch((err) => {
    console.error(err);
    process.exitCode = 1;
  });
}

export { forceDirectedLayout, buildEdges, mulberry32 };
