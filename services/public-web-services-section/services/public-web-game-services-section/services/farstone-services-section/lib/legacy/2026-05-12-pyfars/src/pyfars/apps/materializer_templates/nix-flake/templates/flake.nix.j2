# {{ polity.title or "(missing polity)" }} — flake.nix
#
# Harness-generated by `{{ generation_command }}` at {{ generated_at }}.
# Do not hand-edit. Edit the template at
# pyfars.harnesses:nix-flake/templates/flake.nix.j2
# and re-run the install command.
#
# This flake is the polity's projection into Nix per
# governance/specifications/nix-harness.md. The harness emits ONLY
# structure (inputs, packages, apps, devShells, nixosConfigurations);
# operator-orchestration verbs (deploy, rollback, status, iterate)
# live outside this flake projection and compose the package/app
# surface emitted here.
#
# Each computer system the polity has registered (under
# records/command/group/computer-systems/) with a nix-system declared
# appears as its own devShell. Only systems whose records explicitly
# set nixos-managed: true project a NixOS host configuration.

{
  description = "{{ polity.title or "561 Group operational substrate" }} — operational substrate (pyfars)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
    # Tool packages — substrate-derived from each tool's own ``_index.md``
    # ``nix-package:`` frontmatter block (per nix-harness.md §4.3, the
    # ``kind: nix-input`` outbound projection). Tool-developers maintain
    # these declarations from within their own tool directories. For dev
    # iteration without push-to-github, override at build time with
    # ``--override-input <tool> path:./tools/<class>/<tool>``.
{%- for pkg in tool_packages %}
    {{ pkg.input_name }} = {
      url = "{{ pkg.flake_url }}";
{%- for follow in pkg.follows_inputs %}
      inputs.{{ follow }}.follows = "{{ follow }}";
{%- endfor %}
    };
{%- endfor %}
  };

  outputs = { self, nixpkgs, flake-utils{% for pkg in tool_packages %}, {{ pkg.input_name }}{% endfor %} }:
    let
      substrateRoot = ./{{ substrate_root }};

      # Polity's computer systems (substrate-derived). Each entry is one
      # system that has declared a nix-system; systems without one are
      # absent. NixOS host configurations are emitted only for records
      # that explicitly set nixos-managed: true.
      polityComputerSystems = [
{%- for cs in computer_systems %}
        {
          slug = "{{ cs.slug }}";
          title = "{{ cs.title }}";
          description = "{{ cs.description }}";
          nixSystem = "{{ cs.nix_system }}";
          role = "{{ cs.role }}";
          hostClass = "{{ cs.host_class }}";
          osFamily = "{{ cs.os_family }}";
          deploymentClass = "{{ cs.deployment_class }}";
          nixosManaged = {{ "true" if cs.nixos_managed else "false" }};
          serviceManager = "{{ cs.service_manager }}";
          runtimeRoot = "{{ cs.runtime_root }}";
          primaryUser = "{{ cs.primary_user or "" }}";
        }
{%- endfor %}
      ];

      nixosManagedComputerSystems = builtins.filter
        (cs: cs.nixosManaged) polityComputerSystems;

      mkNixosConfiguration = cs: nixpkgs.lib.nixosSystem {
        system = cs.nixSystem;
        specialArgs = {
          inherit self pyfars substrateRoot;
          computerSystem = cs;
        };
        modules = [
          self.nixosModules.host-defaults
          self.nixosModules.host-users
          self.nixosModules.pyfars-engine
          self.nixosModules.nginx-tls
          self.nixosModules.publication-serving
          ({ lib, ... }: {
            networking.hostName = lib.mkDefault cs.slug;
            system.stateVersion = lib.mkDefault "25.11";
          })
        ];
      };

      mkDeployNode = cs: {
        hostname = cs.slug;
        profiles.system = {
          user = "root";
          path = self.nixosConfigurations.${cs.slug}.config.system.build.toplevel;
        };
      };
    in
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = nixpkgs.legacyPackages.${system};
        lib = pkgs.lib;
        python = pkgs.python313;

        pyfarsPkg = pyfars.packages.${system}.default;

        commonShellPackages = [
          python
          pyfarsPkg
          pkgs.git
        ];

        mkSystemShell = cs: pkgs.mkShell {
          name = "${cs.slug}-devshell";
          packages = commonShellPackages;
          shellHook = ''
            echo "{{ polity.title or "561 Group" }} — computer system: ${cs.title} (${cs.hostClass})"
            echo "  ${cs.description}"
            echo "  deployment: ${cs.deploymentClass}"
            echo "  python: $(${python}/bin/python --version)"
            echo "  pyfars: $(command -v pyfars)"
          '';
        };

        # Computer systems whose declared nix-system matches the system
        # this flake output is being evaluated for. Other systems'
        # devShells are not emitted on this Nix system.
        systemsForThisSystem = lib.filter
          (cs: cs.nixSystem == system) polityComputerSystems;
        systemShells = lib.listToAttrs (map
          (cs: { name = cs.slug; value = mkSystemShell cs; })
          systemsForThisSystem);

        # ── Polity task-shells, declared in
        # governance/assets/computing/nix-flake.md (devshells: section). ──
        # Each entry of polityTaskShells below is a record of:
        #   { slug; purpose; nixpkgsPackages; pythonExtras;
        #     toolDefault; toolShellMerge; }
        # toolDefault names tool inputs whose default package goes on
        # PATH; toolShellMerge names tool inputs whose own
        # devShells.default.nativeBuildInputs are unioned in. Both are
        # filtered against the inputs this flake actually declares.
        polityTaskShells = [
{%- for ds in polity_devshells %}
          {
            slug = "{{ ds.name }}";
            purpose = "{{ ds.purpose | replace('"', '\\"') }}";
            nixpkgsPackages = with pkgs; [{% for p in ds.nixpkgs_packages %} {{ p }}{% endfor %} ];
            pythonExtras   = with python.pkgs; [{% for p in ds.python_extras %} {{ p }}{% endfor %} ];
            toolDefault    = [{% for s in ds.tool_default %}{% if s in tool_input_names %} "{{ s }}"{% endif %}{% endfor %} ];
            toolShellMerge = [{% for s in ds.tool_shell_merge %}{% if s in tool_input_names %} "{{ s }}"{% endif %}{% endfor %} ];
          }
{%- endfor %}
        ];

        # Map a tool slug to the actual flake input. Centralized so
        # toolDefault / toolShellMerge can stay slug-only.
        toolInputBySlug = {
{%- for slug in tool_input_names %}
          {{ slug }} = {{ slug }};
{%- endfor %}
        };

        toolDefaultPkgs = slugs: lib.concatMap (slug:
          let f = toolInputBySlug.${slug};
          in [ (f.packages.${system}.default) ]
        ) slugs;

        # Reach into a foreign devShell's package list. mkShell stores
        # them in nativeBuildInputs (this is fragile against future
        # nixpkgs changes, but is the only path that doesn't require
        # each tool to publish a separate `shell-packages` attr).
        toolMergedShellPkgs = slugs: lib.concatMap (slug:
          let
            f = toolInputBySlug.${slug};
            ds = f.devShells.${system}.default or null;
          in
            if ds == null then []
            else (ds.nativeBuildInputs or [])
        ) slugs;

        mkPolityTaskShell = ts: pkgs.mkShell {
          name = "polity-{{ polity.slug or "561" }}-${ts.slug}-devshell";
          packages =
            ts.nixpkgsPackages
            ++ (toolDefaultPkgs ts.toolDefault)
            ++ (toolMergedShellPkgs ts.toolShellMerge)
            ++ (map (p: p) ts.pythonExtras);
          shellHook = ''
            echo "{{ polity.title or "561 Group" }} — .#${ts.slug}"
            echo "  ${ts.purpose}"
          '';
        };

        polityTaskShellAttrs = lib.listToAttrs (map
          (ts: { name = ts.slug; value = mkPolityTaskShell ts; })
          polityTaskShells);

      in {
        # ── packages — what `nix build .#X` settles ──
        # One entry per declared tool input (default = pyfars). These
        # are the cells the substrate registers as `kind: nix-package`
        # per nix-harness.md §4.3 (today via tool _index.md
        # nix-package: frontmatter; same outbound projection).
        packages = {
{%- for pkg in tool_packages %}
          {{ pkg.package_name }} = {{ pkg.input_name }}.packages.${system}.default;
{%- endfor %}
          default = pyfarsPkg;
        };

        # ── checks — cheap sanity checks runnable via `nix flake check` ──
        checks = {
          pyfars-package = pyfarsPkg;
          pyfars-help = pkgs.runCommand "pyfars-help-check" { } ''
            ${pyfarsPkg}/bin/pyfars --help > $out
          '';
        };

        # ── devShells — what `nix develop .#X` enters ──
        # `default` is the polity-wide minimal shell. Per-computer-system
        # shells (named by computer-system slug) carry host-specific
        # context. Polity-task-shells composed from substrate
        # (governance/assets/computing/nix-flake.md devshells:) merge
        # nixpkgs deps with selected tool inputs' shell packages.
        devShells = systemShells // polityTaskShellAttrs // {
          default = pkgs.mkShell {
            name = "polity-{{ polity.slug or "561" }}-devshell";
            packages = commonShellPackages;
            shellHook = ''
              echo "{{ polity.title or "561 Group" }} — generic devshell"
              echo "  python: $(${python}/bin/python --version)"
              echo "  pyfars: $(command -v pyfars)"
            '';
          };
        };

        # ── apps — what `nix run .#X` invokes ──
        # `apps.pyfars` is the canonical engine entrypoint. Operators
        # invoke `nix run .#pyfars -- run /path/to/polity` (or any
        # other pyfars subverb). Deploy/rollback/iterate procedures
        # compose this app cell; they don't replace it.
        apps.pyfars = {
          type = "app";
          program = "${pyfarsPkg}/bin/pyfars";
        };
      }) // {
        # ── nixosModules — substrate-derivable host configuration ──
        # The polity's reusable NixOS modules. Composed by
        # mkNixosConfiguration per nixos-managed computer system.
        nixosModules = {
          host-defaults = { lib, pkgs, computerSystem, ... }: {
            nixpkgs.hostPlatform = lib.mkDefault computerSystem.nixSystem;
            boot.loader.grub.devices = lib.mkDefault [ "nodev" ];
            fileSystems."/" = lib.mkDefault {
              device = "/dev/disk/by-label/nixos";
              fsType = "ext4";
            };
            environment.systemPackages = [
              pkgs.git
              pyfars.packages.${pkgs.stdenv.hostPlatform.system}.default
            ];
            services.openssh.enable = lib.mkDefault true;
          };

          host-users = { lib, config, computerSystem, ... }: {
            options.pyfars.hostUsers.primaryUser = lib.mkOption {
              type = lib.types.nullOr lib.types.str;
              default = if computerSystem.primaryUser == "" then null else computerSystem.primaryUser;
              description = "Primary substrate user slug for this host.";
            };
            config = lib.mkIf (config.pyfars.hostUsers.primaryUser != null) {
              users.users.${config.pyfars.hostUsers.primaryUser} = {
                isNormalUser = lib.mkDefault true;
                extraGroups = lib.mkDefault [ "wheel" ];
              };
            };
          };

          # Single ``pyfars-engine`` service: spawns MCP / web /
          # control-plane services from substrate and runs its own
          # clock inside; one systemd unit is enough.
          pyfars-engine = { lib, pkgs, config, substrateRoot, ... }: {
            options.services.pyfars-engine = {
              enable = lib.mkEnableOption "PyFARS engine (boots a polity)";
              user = lib.mkOption {
                type = lib.types.str;
                default = "pyfars";
              };
              workingDirectory = lib.mkOption {
                type = lib.types.path;
                default = "/srv/561";
                description = "Live writable checkout path; do not point long-running services at the Nix store source.";
              };
              environmentFile = lib.mkOption {
                type = lib.types.nullOr lib.types.path;
                default = null;
                description = "Runtime secret environment file; never inline secrets in the flake.";
              };
            };
            config = lib.mkIf config.services.pyfars-engine.enable {
              users.users.${config.services.pyfars-engine.user} = {
                isSystemUser = true;
                group = config.services.pyfars-engine.user;
              };
              users.groups.${config.services.pyfars-engine.user} = { };
              systemd.services.pyfars-engine = {
                description = "PyFARS engine";
                wantedBy = [ "multi-user.target" ];
                after = [ "network-online.target" ];
                wants = [ "network-online.target" ];
                serviceConfig = {
                  User = config.services.pyfars-engine.user;
                  WorkingDirectory = config.services.pyfars-engine.workingDirectory;
                  ExecStart = "${pyfars.packages.${pkgs.stdenv.hostPlatform.system}.default}/bin/pyfars run ${config.services.pyfars-engine.workingDirectory}";
                  Restart = "on-failure";
                } // lib.optionalAttrs (config.services.pyfars-engine.environmentFile != null) {
                  EnvironmentFile = config.services.pyfars-engine.environmentFile;
                };
              };
            };
          };

          nginx-tls = { lib, config, ... }: {
            options.services.pyfars-nginx-tls.enable =
              lib.mkEnableOption "nginx with ACME defaults for PyFARS hosts";
            config = lib.mkIf config.services.pyfars-nginx-tls.enable {
              services.nginx.enable = true;
              security.acme.acceptTerms = true;
            };
          };

          publication-serving = { lib, config, ... }: {
            options.services.pyfars-publications.sites = lib.mkOption {
              type = lib.types.attrsOf (lib.types.submodule {
                options = {
                  root = lib.mkOption { type = lib.types.path; };
                  hostName = lib.mkOption { type = lib.types.str; };
                  enableACME = lib.mkOption {
                    type = lib.types.bool;
                    default = true;
                  };
                };
              });
              default = { };
            };
            config.services.nginx.virtualHosts = lib.mapAttrs' (_name: site:
              lib.nameValuePair site.hostName {
                root = site.root;
                enableACME = site.enableACME;
                forceSSL = site.enableACME;
              }
            ) config.services.pyfars-publications.sites;
          };
        };

        # ── nixosConfigurations — one per nixos-managed computer system ──
        nixosConfigurations = builtins.listToAttrs (map
          (cs: { name = cs.slug; value = mkNixosConfiguration cs; })
          nixosManagedComputerSystems);

        # ── deploy.nodes — for deploy-rs and similar tooling ──
        deploy.nodes = builtins.listToAttrs (map
          (cs: { name = cs.slug; value = mkDeployNode cs; })
          nixosManagedComputerSystems);
      };
}
